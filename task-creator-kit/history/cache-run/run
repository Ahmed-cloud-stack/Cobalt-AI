#!/bin/bash
set -euo pipefail
d=$(CDPATH='' cd -- "$(dirname -- "$0")"/.. && pwd)
for mode in "$@"; do
    docker run --rm --network none --cpus 2 --memory 4096m \
        -v "$d/frozen-task/tests:/fixture:ro" -v "$d/cache-run:/cache-ro:ro" \
        -v "$d/sealed/$mode:/submission:ro" "$(cat "$d/image")" sh -ec '
          cp -r /fixture /tests
          chmod 700 /tests
          install -m 644 /submission/shutter.py /app/shutter.py
          install -m 644 /submission/sample.json /app/output/sample.json
          reward=0
          if python3 -I -S /cache-ro/verify_cached.py; then reward=1; fi
          printf "reward=%s\n" "$reward"
        ' > "$d/$mode.log" 2>&1
    printf 'Attempt %s\n' "$mode"
    rg -v ': PASS' "$d/$mode.log"
done
